    /**
     * Vérifie isMoving() au repos, en mouvement et après l'arrêt.
     */
    public void testIsMoving() {
        System.out.println("TEST : isMoving");
        System.out.println("Prevois de la place puis appuie.");
        Button.waitForAnyPress();

        action.stop();

        System.out.println("Au repos, attendu false : "
                + action.isMoving());

        try {
            action.avancerSansFin(100);
            Delay.msDelay(200);

            System.out.println("En mouvement, attendu true : "
                    + action.isMoving());
        } finally {
            action.stop();
        }

        System.out.println("Apres arret, attendu false : "
                + action.isMoving());

        Button.waitForAnyPress();
    }

    
    /**
     * Vérifie la valeur initiale de la boussole.
     *
     * Dans la version actuelle de Action, actBoussole()
     * n'est jamais appelée : la valeur reste donc à zéro.
     */
    /**
     * Vérifie la mise à jour de la boussole après deux rotations.
     * Convention : gauche positive, droite négative.
     */
    public void testGetBoussole() {
        System.out.println("TEST : getBoussole");
        System.out.println("Le robot tournera a gauche puis a droite.");
        System.out.println("ENTER pour demarrer.");
        Button.ENTER.waitForPressAndRelease();

        int orientationInitiale = action.getBoussole();

        try {
            System.out.println("Boussole initiale : " + orientationInitiale);

            action.tournerG(90);

            int apresGauche = action.getBoussole();

            System.out.println("Apres gauche : " + apresGauche);
            System.out.println("Variation attendue : +90 degres");

            boolean gaucheCorrecte =
                    (apresGauche - orientationInitiale - 90) % 360 == 0;

            System.out.println("Test gauche reussi : " + gaucheCorrecte);

            action.tournerD(90);

            int apresDroite = action.getBoussole();

            System.out.println("Apres droite : " + apresDroite);
            System.out.println("Retour attendu : " + orientationInitiale);

            boolean retourCorrect =
                    (apresDroite - orientationInitiale) % 360 == 0;

            System.out.println("Test retour reussi : " + retourCorrect);
            System.out.println("Verifie aussi l'orientation physique.");

        } finally {
            action.stop();
        }

        Button.ENTER.waitForPressAndRelease();
    }

