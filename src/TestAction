    /**
     * Vérifie que la rotation gauche est asynchrone :
     * le programme poursuit son exécution pendant le mouvement.
     */
    public void testAsyncTournerG() {
        System.out.println("TEST : asyncTournerG");
        System.out.println("Repere l'orientation puis appuie.");
        Button.waitForAnyPress();

        try {
            action.asyncTournerG(90);

            System.out.println("Appel termine : rotation encore en cours ?");
            System.out.println("isMoving : " + action.isMoving());

            while (action.isMoving() && !Button.ESCAPE.isDown()) {
                Delay.msDelay(20);
            }
        } finally {
            action.stop();
        }

        System.out.println("Attendu : message pendant la rotation.");
        System.out.println("Verifie aussi : 90 degres vers la gauche.");
        Button.waitForAnyPress();
    }

