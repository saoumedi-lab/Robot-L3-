import lejos.hardware.Button;
import lejos.utility.Delay;

public class RobotDeFou {

    public static void main(String[] args) {
        System.out.println("Initialisation...");

        // 1. Instanciation des composants du robot
        Capteur capteurs = new Capteur();
        Action robot = new Action();

        System.out.println("Avance jusqu'à la détection d'une collision...");

        // 2. Lance l'avance continue (vitesse de 150 mm/s)
        robot.avancerSansFin(100);

      
       // 3. des qu'on detecte le palet on ouvre les pinces
		while(capteurs.distance() > 0.30f) {
			while (capteur.detecterPression() && Button.ESCAPE.isDown()) { //arrete si bouton presser
 				robot.stop();
        	}
		}

        // 4. Arrêt immédiat lors de la pression sur le capteur de contact
        robot.stop();
        System.out.println("Obstacle détecté !");
        robot.ouvrirPince();
        robot.avancerSansFin(30);    // On avance jusqu'a ce que le capteur soit enclencher

		while (!capteur.detecterPression() && !Button.ESCAPE.isDown()) {
            Delay.msDelay(20); // Pause pour ne pas surcharger le processeur EV3
        }
        robot.serrerPince();    // On attrape le palet
	
        System.out.println("Palet attrapé avec succès !");

       

        // 6. RETOUR : On fait demi-tour pour ramener le palet dans le camp
		robot.tournerD(180);
        Delay.msDelay(1000); // Pause finale pour lire le message à l'écran

        // 7. DÉPÔT INTELLIGENT : On utilise la méthode 'lacher' qu'on a codée pour aller jusqu'à la ligne blanche
		robot.lacher(capteurs);
        //8.Fermeture propre des capteurs
        capteurs.fermer();
    }
 }
