import lejos.hardware.Button;
import lejos.utility.Delay;

public class RobotDeFou {

    public static void main(String[] args) {

        System.out.println("Initialisation...");

        // 1. Instanciation des composants du robot
        Capteur capteur = new Capteur();
        Action robot = new Action();


        System.out.println("Avance jusqu'a la détection du palet...");

        // 2. Lance l'avance continue (vitesse 100 mm/s)
        robot.avancerSansFin(150);

        // 3. Avance tant que le palet est à plus de 40 cm
        while (capteur.distance() > 0.40f && !Button.ESCAPE.isDown()) {
            Delay.msDelay(20);
        }

        // 4. Dès qu'on s'approche du palet, on stoppe, on ouvre la pince et on termine l'approche
        robot.stop();
        System.out.println("Palet en vue ! Ouverture pince...");
        robot.ouvrirPince();
        
        robot.avancerSansFin(50); // Avance lentement vers le palet

        // Wait jusqu'au choc physique avec le capteur de pression
        while (!capteur.detecterPression() && !Button.ESCAPE.isDown()) {
            Delay.msDelay(20);
        }

        // 5. Fermeture de la pince
        robot.stop();
        robot.serrerPince();
        System.out.println("Palet attrapé avec succès !");

        // 6. RETOUR : Demi-tour pour ramener le palet
        robot.tournerD(180);
        Delay.msDelay(1000);

        // 7. DÉPÔT INTELLIGENT
        robot.lacher(capteur);

        // 8. Fermeture propre des capteurs à la toute fin
        capteur.fermer();
        System.out.println("Séquence terminée.");
    }
}
}
robot.stop();
 }
